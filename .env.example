# ==============================================================================
# ENVIRONMENT VARIABLES FOR PRIVATE BIRTHDAY SITE & NO-CODE EDITOR
# ==============================================================================
#
# HOSTED ON VERCEL ONLY (Free Tier)
# - Database: Neon Postgres (provisioned via Vercel Marketplace)
# - Storage: Vercel Blob in Private Mode (created in Vercel Storage tab)
# - Compute: Two Vercel Projects connected to one repo
#
# Note: Vercel automatically injects DATABASE_URL and BLOB_READ_WRITE_TOKEN
# when you connect the storage and database from the Vercel dashboard!
#
# ==============================================================================
# 1. PUBLIC SITE ENVIRONMENT VARIABLES (Vercel Project: "birthday-site")
# ==============================================================================

# Visitor Gate Password Hash (Generate with: npm run hash-password)
VISITOR_PASSWORD_HASH="scrypt$16384$8$1$..."

# Cryptographic secret for signing visitor session cookies (Generate: openssl rand -hex 32)
VISITOR_SESSION_SECRET="generate-a-random-64-character-hex-string-for-visitor-sessions"

# Database Connection (Automatically injected by Vercel when connecting Neon)
DATABASE_URL="postgres://neondb_owner:your_password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob Storage Token (Automatically injected by Vercel when connecting Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."


# ==============================================================================
# 2. EDITOR STUDIO ENVIRONMENT VARIABLES (Vercel Project: "birthday-editor")
# ==============================================================================

# Editor Studio Password Hash (MUST BE COMPLETELY DIFFERENT FROM VISITOR PASSWORD)
# Generate with: npm run hash-password
EDITOR_PASSWORD_HASH="scrypt$16384$8$1$..."

# Cryptographic secret for signing editor session cookies (MUST BE DIFFERENT FROM VISITOR SECRET)
EDITOR_SESSION_SECRET="generate-a-different-64-character-hex-string-for-editor-sessions"

# Database Connection (Connect to the same Neon Postgres database)
DATABASE_URL="postgres://neondb_owner:your_password@ep-xyz.region.aws.neon.tech/neondb?sslmode=require"

# Vercel Blob Storage Token (Connect to the same Vercel Blob store)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
